{
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store"
  ],
  "project_panel": {
    "auto_reveal_entries": true,
    "auto_fold_dirs": false
  },
  "assistant": {
    "enabled": true,
    "version": "2",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514"
    }
  },
  "file_types": {
    "JSON": ["json"],
    "Markdown": ["md"],
    "PDF": ["pdf"]
  }
}
